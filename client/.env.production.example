# ========================================
# PRODUCTION ENVIRONMENT VARIABLES
# ========================================
# Copy this file to .env.production for production builds

# AWS Elastic Beanstalk (Production)
VITE_API_BASE=https://crm-be.eba-nt49vbgx.ap-south-1.elasticbeanstalk.com
VITE_WS_BASE=wss://crm-be.eba-nt49vbgx.ap-south-1.elasticbeanstalk.com

# Geofence map picker needs no configuration — Leaflet + OpenStreetMap, key-free.

# IMPORTANT NOTES:
# 1. Ensure AWS Elastic Beanstalk has SSL certificate configured
# 2. WebSocket connects at root (no /ws path needed)
# 3. Both API and WS should use secure protocols (https/wss)
# 4. Geofencing needs HTTPS end to end — browsers refuse navigator.geolocation
#    on plain http (localhost excepted), so the location check cannot run
#    without a valid certificate.
