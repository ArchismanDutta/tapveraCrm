# ==============================================
# CRITICAL: AWS DEPLOYMENT SETTINGS
# ==============================================
# For AWS Elastic Beanstalk deployment, set PORT=8081
# For local development, use PORT=5000
PORT=5000

# ==============================================
# DATABASE CONFIGURATION (REQUIRED)
# ==============================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# ==============================================
# SECURITY (REQUIRED)
# ==============================================
JWT_SECRET=your_jwt_secret_here

# ==============================================
# REDIS (REQUIRED — Socket.IO real-time layer)
# ==============================================
# Socket.IO uses Redis as its adapter so notifications/chat/project events
# reach the right connected user regardless of which server instance they're
# on (see server/config/redis.js and server/socket/index.js).
#
# Local development: install Redis and run it with defaults, e.g.:
#   macOS:   brew install redis && brew services start redis
#   Ubuntu:  sudo apt install redis-server && sudo systemctl start redis-server
#   Docker:  docker run -d -p 6379:6379 redis:7-alpine
# The default below matches a default local install — usually no changes needed.
#
# Production (AWS): point this at an ElastiCache for Redis endpoint, e.g.
#   REDIS_URL=redis://your-cluster.xxxxx.ng.0001.aps1.cache.amazonaws.com:6379
REDIS_URL=redis://127.0.0.1:6379

# ==============================================
# FRONTEND URL (REQUIRED FOR PRODUCTION)
# ==============================================
# CRITICAL: Set this to your production domain for AWS deployment
# DO NOT use localhost in production
# Example: https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# Optional: Additional frontend origin for CORS
FRONTEND_ORIGIN=

# ==============================================
# NODE ENVIRONMENT
# ==============================================
# Set to "production" for AWS deployment
NODE_ENV=development

# ==============================================
# EMAIL CONFIGURATION (REQUIRED)
# ==============================================
# IMPORTANT: Use Gmail App Password (NOT your regular Gmail password)
#
# How to generate Gmail App Password:
# 1. Enable 2-Factor Authentication on your Gmail account
# 2. Go to: https://myaccount.google.com/apppasswords
# 3. Select "Mail" and your device
# 4. Copy the 16-character password (remove spaces)
# 5. Paste it as EMAIL_PASS below
#
# This approach is stable and doesn't require OAuth refresh tokens
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password_here

# ==============================================
# GMAIL API (DEPRECATED - OAuth has refresh token issues)
# ==============================================
# The following Gmail API settings are no longer used.
# We now use SMTP with App Password for stable email delivery.
# You can safely ignore or remove these variables.
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
# GMAIL_REDIRECT_URI=

# ==============================================
# WHATSAPP INTEGRATION (Optional - Meta WhatsApp Business API)
# ==============================================
# Setup Instructions:
# 1. Create a Meta Business Account at https://business.facebook.com/
# 2. Add WhatsApp to your business account
# 3. Go to WhatsApp > API Setup
# 4. Get your Access Token and Phone Number ID
# 5. Add test numbers or verify your production number

# Your WhatsApp Business API access token (from Meta Business Suite)
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token_here

# Your WhatsApp Phone Number ID (found in WhatsApp > API Setup)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# Admin phone numbers to receive task/help notifications (comma-separated, with country code)
# Format: +1234567890,+9876543210 (must include country code)
# These admins will receive WhatsApp notifications for:
# - New tasks created/updated/deleted
# - Task submissions and approvals
# - Help center issues
ADMIN_NUMBERS=+1234567890,+0987654321

# Alternative variable name for compatibility (optional)
ADMIN_WHATSAPP_NUMBERS=

# Admin emails for help center notifications (comma-separated)
ADMIN_EMAILS=admin1@example.com,admin2@example.com

# ==============================================
# ENCRYPTION (for per-user email passwords)
# ==============================================
ENCRYPTION_KEY=your_32_character_encryption_key
ENCRYPTION_IV=your_32_character_encryption_iv

# ==============================================
# GOOGLE SERVICE ACCOUNT (for Sheets API)
# ==============================================
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://yourdomain.com/api/sheets/callback
GOOGLE_PROJECT_ID=your_project_id
GOOGLE_PRIVATE_KEY_ID=your_private_key_id
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key_here\n-----END PRIVATE KEY-----"
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com

# ==============================================
# AWS S3 CONFIGURATION (Optional - for file uploads)
# ==============================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your_bucket_name

# CloudFront domain for CDN delivery (optional, improves file delivery speed)
CLOUDFRONT_DOMAIN=your_cloudfront_distribution_domain.cloudfront.net

# ==============================================
# AI ANALYTICS (Optional - for attendance insights)
# ==============================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=google/gemma-2-9b-it:free

# ==============================================
# SERPAPI (automated keyword rank tracking)
# ==============================================
# Get your API key from: https://serpapi.com/
# Free tier: 100 searches/month
# Paid plans available for higher volume
#
# SERPAPI_MONTHLY_LIMIT controls the quota guard (default 100).
# When the limit is reached, the system automatically falls back to
# Playwright scraping for high-priority keywords (rank ≤ 20 or priority:high).
#
# Leave SERPAPI_KEY blank to run on Playwright-only mode (top keywords only).
# ==============================================
SERPAPI_KEY=your_serpapi_key_here
SERPAPI_MONTHLY_LIMIT=100

# ==============================================
# PLAYWRIGHT PROXY (optional)
# ==============================================
# Add a proxy if you're running on a cloud server (AWS/GCP/Azure) and
# experiencing Google CAPTCHAs during Playwright scraping.
# Format: http://user:pass@proxy-ip:port  OR  http://proxy-ip:port
# Leave blank for direct connections (fine for low-volume local/VPS use).
# ==============================================
PLAYWRIGHT_PROXY=

# ==============================================
# AWS LAMBDA INTEGRATION (keyword rank fetcher)
# ==============================================
# The keyword rank fetcher runs as an AWS Lambda function triggered by
# EventBridge (see template.yaml). These vars allow Lambda to call back
# into this server for rank-drop notifications.
#
# CRM_SERVER_URL: public base URL of this server (no trailing slash)
# INTERNAL_WEBHOOK_SECRET: any long random string — must match Lambda's env var
# ==============================================
CRM_SERVER_URL=https://your-domain.com
INTERNAL_WEBHOOK_SECRET=your_long_random_secret_here
# ─────────────────────────────────────────────────────────────────────────────
# FILE STORAGE (in-house Linux server)
# ─────────────────────────────────────────────────────────────────────────────
# Where uploaded documents and media live. MUST be outside the deploy directory
# — the previous default (<repo>/server/uploads) sits inside the tree a deploy
# replaces, so a fresh checkout or rsync destroys every attachment.
# Give it its own mount so it can be backed up and grown independently.
#
#   sudo mkdir -p /var/lib/tapvera/uploads
#   sudo chown -R <app-user>:<app-user> /var/lib/tapvera/uploads
#   sudo chmod 700 /var/lib/tapvera/uploads
#
# Migrate existing files with:
#   node scripts/migrateUploadsToStorageRoot.js --dry-run
# Which storage backend handles uploads: "local" or "s3".
#
# Set this EXPLICITLY. It used to be inferred from whether the AWS_* variables
# were present, which breaks badly when you migrate off AWS: the variables stay
# in .env, the inference still says "use S3", and every upload is shipped to a
# bucket whose credentials no longer work. The symptom is a 500 on sending any
# file, and the cause (InvalidAccessKeyId) only appears in the server log.
#
# local = files on this server under UPLOAD_ROOT (in-house deployment)
# s3    = requires AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_S3_BUCKET_NAME,
#         and the server refuses to start without them
STORAGE_DRIVER=local

UPLOAD_ROOT=/var/lib/tapvera/uploads

# How long a signed file link stays valid. Files are served only to a valid
# signature (or Bearer token) — long enough to load a page of images and start
# a video, short enough that a link pasted elsewhere expires on its own.
UPLOAD_URL_TTL_SECONDS=900

# Signing key for those links. Falls back to JWT_SECRET when unset, but a
# dedicated key is better: rotating it invalidates every outstanding file link
# without logging anybody out. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
UPLOAD_SIGNING_SECRET=

# Hand file delivery to nginx via X-Accel-Redirect once the location block below
# is in place. Node then authorizes and nginx streams the bytes with sendfile()
# and full HTTP range support — which matters because uploads may be 10MB
# videos, and streaming those through Node competes with every open socket.
# Leave false for local dev (no nginx) — res.sendFile is used instead.
#
#   # nginx, inside the same server block as /api:
#   location /protected-uploads/ {
#       internal;                        # only reachable via X-Accel-Redirect
#       alias /var/lib/tapvera/uploads/; # must match UPLOAD_ROOT, trailing slash
#   }
UPLOAD_USE_XACCEL=false
UPLOAD_INTERNAL_LOCATION=/protected-uploads

# Max size for any single upload (bytes) — leave documents, chat/project
# attachments, screenshots. 200MB.
#
# One shared ceiling for every file type, enforced per-file by multer's own
# byte count as each part streams in. This used to be tiered (50MB default,
# 200MB for video specifically, because a 30-second phone clip is 30-60MB and
# a flat 50MB cap made video unusable) with a pre-check that compared the
# WHOLE request's Content-Length against the smaller cap — which rejected
# multi-file sends and larger archives (zip) that were nowhere near actually
# too big, since Content-Length is the size of the entire request, not of any
# one file in it. Collapsed to one number so that bug can't recur; multer's
# real per-file limit below doesn't have the problem the pre-check did. Files
# are on our own disk now, so a generous number is a disk/backup decision
# rather than an egress-cost one.
UPLOAD_MAX_BYTES=209715200

# Minutes to ADD to every punch the fingerprint terminal reports, compensating
# for a device clock we can't fix at the source. 30 = device runs 30 min slow
# (the TimeZone-truncation symptom: a 05:00 arrival stamped 04:30).
#
# ⚠️  This corrects a BROKEN clock. If the device clock is ever fixed, set this
# back to 0 — otherwise punches land 30 minutes LATE instead, the same bug
# pointing the other way. The server warns in the log when that happens.
#
# Per-device override: BiometricDevice.clockOffsetMinutes (takes precedence).
BIOMETRIC_CLOCK_OFFSET_MINUTES=0

# ── ADMS device polling load ─────────────────────────────────────────────
# Seconds between the terminal's command polls (GET /iclock/getrequest) — the
# `Delay=` line in the handshake. Clamped to 5..3600.
#
# ⚠️  This is NOT punch latency. Punches arrive via Realtime=1 within a second
# or two of the scan regardless of this value. `Delay` paces only the separate
# "any commands for me?" poll, which currently always answers OK.
#
# Was hardcoded at 10 = 8,640 no-op round-trips per device per day, each
# costing a request, a device lookup and a liveness write. Lower this only if
# real device commands are implemented and their latency starts to matter.
#
# Takes effect at the device's next handshake (boot, or a TransTimes sync
# point — 00:00 / 14:05), not immediately.
BIOMETRIC_POLL_DELAY_SECONDS=60

# Minimum seconds between `lastSeenAt` heartbeat writes per device. The poll
# used to write one per request; this caps it. Only affects how fresh the
# "last seen" label in the admin UI is — handshake telemetry (IP, firmware) is
# never throttled. 0 disables throttling.
BIOMETRIC_TOUCH_THROTTLE_SECONDS=300

# Seconds to cache the ?SN= -> device lookup, on the POLL endpoints only.
# The handshake and the attendance push always read fresh, so `enabled`,
# `dryRun` and `clockOffsetMinutes` can never be stale for anything that
# writes attendance. Admin edits invalidate the cache immediately; the TTL is
# only a backstop for changes made directly in the database. 0 disables it.
#
# ⚠️  Must be comfortably LARGER than BIOMETRIC_POLL_DELAY_SECONDS, or entries
# expire in step with the polls meant to hit them and the cache does nothing.
# Rule of thumb: at least 5x the poll interval.
BIOMETRIC_DEVICE_CACHE_SECONDS=300

# Log the no-op command poll again (one line per poll per device). Off by
# default — it produced ~90k identical lines that buried the handshakes and
# pushes. Turn on when diagnosing a device that has gone quiet.
BIOMETRIC_LOG_POLLS=false

# ── HTTP request logging ─────────────────────────────────────────────────
# morgan format: dev | combined | common | short | tiny.
# Defaults to "combined" when NODE_ENV=production (no ANSI colour codes in the
# log file), "dev" otherwise. In production, successful /health and
# /socket.io/ polling requests are skipped; errors always log.
# Set HTTP_LOG=off to disable request logging entirely.
# HTTP_LOG_FORMAT=combined
# HTTP_LOG=off

# ── Web push (desktop notifications) ─────────────────────────────────────
# Without these, push is silently disabled: the server logs a warning at boot,
# /api/push/public-key reports enabled:false, and the client's Desktop
# notifications toggle refuses to turn on rather than pretending to work.
#
# Generate a pair ONCE with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
#
# ⚠️  TREAT THE PRIVATE KEY LIKE A PASSWORD, AND DO NOT ROTATE CASUALLY.
# The keypair identifies this server to the browser push services. Change it and
# every existing PushSubscription becomes undeliverable — silently, with no
# error and no way for a user to notice except that notifications stop. Everyone
# has to re-enable notifications by hand. Rotate only if the private key leaks,
# and prefer doing it while few people are subscribed.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Contact address the push service can reach you at if a subscription
# misbehaves. Must be a mailto: or https: URL. Defaults to mailto:support@tapvera.io.
VAPID_SUBJECT=mailto:support@tapvera.io
